# .env.example

# Database Configuration (PostgreSQL)
POSTGRES_USER=admin
POSTGRES_PASSWORD=changeme
POSTGRES_DB=inventory_db

# Application Config
# The backend uses this to connect to the DB container internally
DATABASE_URL=postgresql://admin:changeme@db:5432/inventory_db

# Cache Config
# The backend uses this to connect to the Redis container internally
REDIS_URL=redis://redis:6379